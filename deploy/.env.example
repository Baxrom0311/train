# deploy/.env sifatida nusxalang:  cp deploy/.env.example deploy/.env
# Qiymatlarni o'zingiz to'ldiring — bu yerda haqiqiy kalitlar YO'Q.

# PostgreSQL
POSTGRES_USER=tryjob
POSTGRES_PASSWORD=
POSTGRES_DB=tryjob_dev
POSTGRES_TEST_DB=tryjob_test

# JWT — majburiy. Generatsiya: openssl rand -hex 32
SECRET_KEY=

# Frontend tashqi porti
HTTP_PORT=80

# Vergul bilan ajratilgan; nginx bitta domen orqali xizmat qilgani uchun
# odatda faqat sizning domeningiz kerak.
CORS_ORIGINS=http://localhost

# AI provayderlari (ixtiyoriy — bo'sh bo'lsa keyingisiga o'tiladi)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Urinish tartibi va modellar (ixtiyoriy). Embedding faqat Gemini
# (gemini-embedding-001, 768) — GEMINI_API_KEY bo'lmasa RAG faqat
# full-text qidiruv bilan ishlaydi.
LLM_PROVIDERS=deepseek,gemini,openai
DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
# Admin statistikasidagi AI narxi: 1M token uchun USD, provider=kirish/chiqish.
# Bo'sh — faqat tokenlar ko'rsatiladi. Narxni provayderning joriy tarifidan oling.
LLM_PRICES=

# Email bildirishnomalar (ixtiyoriy). SMTP_HOST bo'sh — faqat sayt ichida.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TryJob <no-reply@example.uz>
SMTP_STARTTLS=true
# Emaildagi havolalar uchun sayt manzili
PUBLIC_URL=http://localhost

# API hujjatlari (/docs, /redoc, /openapi.json). Production'da yopiq.
DOCS_ENABLED=false

# HTTPS (docker-compose.https.yml bilan): DNS shu serverga qaragan domen
# va Let's Encrypt xabarlari uchun email.
DOMAIN=
ACME_EMAIL=

# Kunlik zaxira nusxa (deploy/backups/): soat (Toshkent vaqti) va necha kun saqlanadi
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# Sandbox runner tokeni (backend ↔ sandbox). Generatsiya: openssl rand -hex 32
SANDBOX_TOKEN=
