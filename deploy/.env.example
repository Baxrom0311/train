# deploy/.env sifatida nusxalang:  cp deploy/.env.example deploy/.env
# Qiymatlarni o'zingiz to'ldiring — bu yerda haqiqiy kalitlar YO'Q.

# PostgreSQL
POSTGRES_USER=tryjob
POSTGRES_PASSWORD=
POSTGRES_DB=tryjob_dev
POSTGRES_TEST_DB=tryjob_test

# JWT — majburiy. Generatsiya: openssl rand -hex 32
SECRET_KEY=

# Frontend tashqi porti
HTTP_PORT=80

# Vergul bilan ajratilgan; nginx bitta domen orqali xizmat qilgani uchun
# odatda faqat sizning domeningiz kerak.
CORS_ORIGINS=http://localhost

# AI provayderlari (ixtiyoriy — bo'sh bo'lsa keyingisiga o'tiladi)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
