DATABASE_URL=postgresql+asyncpg://user:password@localhost/tryjob_dev
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
REDIS_URL=redis://localhost:6379

# Email bildirishnomalar (ixtiyoriy). SMTP_HOST bo'sh — faqat sayt ichida.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TryJob <no-reply@example.uz>
SMTP_STARTTLS=true
# Emaildagi havolalar uchun sayt manzili
PUBLIC_URL=http://localhost:5173

# API hujjatlari (/docs, /redoc, /openapi.json); production'da false
DOCS_ENABLED=true
