# ─────────────────────────────────────────────────────────────────────────────
# TryJob Platformasi — Production Environment Configuration (.env)
# ─────────────────────────────────────────────────────────────────────────────

# Loyiha muhiti
PROJECT_NAME="TryJob — Virtual Job Simulation Platform"
ENVIRONMENT=production
DEBUG=false
VERSION=1.0.0

# ── PostgreSQL Production Database ───────────────────────────────────────────
# Agar to'liq DATABASE_URL berilsa:
# DATABASE_URL=postgresql+psycopg2://tryjob_user:StrongProdPassword2026!@postgres:5432/tryjob_db

POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tryjob_user
POSTGRES_PASSWORD=StrongProdPassword2026!
POSTGRES_DB=tryjob_db
USE_POSTGRES=true

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300

# ── JWT & Kriptografik Xavfsizlik ─────────────────────────────────────────────
# openssl rand -hex 32 buyrug'i orqali yangi kuchli kalitlar generatsiya qiling
SECRET_KEY=e83a9f21c4091a4b87f63d2e1b9a7c5082d41e7f3c9b0a1e2f4a6c8d0e2b4a6c
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
HMAC_CERT_SECRET=c94b810d7e2a4f6081e3a5c7d9f0b2e4a6c8d0e2f4a6b8c0d2e4f6a8b0c2d4e6

# ── CORS Sozlamalari (Frontend domenlari) ────────────────────────────────────
CORS_ORIGINS=https://tryjob.uz,https://www.tryjob.uz,http://localhost:3000,http://127.0.0.1:3000

# ── Cloud AI Integratsiyalari ─────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GEMINI_API_KEY=your-google-gemini-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Fayllar Xavfsizligi ───────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=15
